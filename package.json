{
  "name": "abap-mirror",
  "displayName": "ABAP Mirror",
  "description": "Mirrors SAP ADT (abap://) documents to real files so AI coding assistants like Claude Code can read and edit them, with every change staying under your review.",
  "version": "0.1.0",
  "publisher": "abgunes",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abgunes/ABAP-Mirror"
  },
  "homepage": "https://github.com/abgunes/ABAP-Mirror",
  "bugs": {
    "url": "https://github.com/abgunes/ABAP-Mirror/issues"
  },
  "engines": { "vscode": "^1.80.0" },
  "icon": "images/icon.png",
  "categories": ["Programming Languages", "Other"],
  "keywords": ["abap", "adt", "sap", "claude", "claude code", "mirror"],
  "activationEvents": ["onStartupFinished"],
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "ABAP Mirror",
      "properties": {
        "abapMirror.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Mirror active abap:// ADT documents to real files (and sync edits back) so Claude Code can read/edit them. Toggle off to fully disable, no reload needed."
        }
      }
    },
    "commands": [
      {
        "command": "abapMirror.open",
        "title": "ABAP Mirror - Open Mirror Object"
      },
      {
        "command": "abapMirror.folder",
        "title": "ABAP Mirror - Mirror Folder (with Sub-Objects)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "abapMirror.open",
          "when": "resourceScheme == abap",
          "group": "z_abapMirror@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "abapMirror.open",
          "when": "resourceScheme == abap",
          "group": "z_abapMirror@1"
        }
      ],
      "explorer/context": [
        {
          "command": "abapMirror.folder",
          "when": "resourceScheme == abap && explorerResourceIsFolder",
          "group": "z_abapMirror@1"
        }
      ]
    },
    "languages": [
      {
        "id": "abap-mirror-view",
        "extensions": [".abapmirror"],
        "aliases": ["ABAP (mirror view)"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "abap-mirror-view",
        "scopeName": "source.abapmirror",
        "path": "./syntaxes/abap-mirror.tmLanguage.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "abapMirror.files",
          "name": "ABAP Mirror Files"
        }
      ]
    }
  }
}
